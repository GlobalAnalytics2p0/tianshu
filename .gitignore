# macOS
*.DS_Store

# Local caches
__pycache__/
*.pyc

# Local video production outputs.
# Keep lightweight plans/metadata/subtitles/thumbnail PNGs trackable, but never commit generated audio/video.
src/resource/**/影片/**/audio/
src/resource/**/影片/**/video/
src/resource/**/影片/**/output/
src/resource/**/影片/**/renders/
src/resource/**/影片/**/source/
src/resource/**/影片/**/qa/
src/resource/**/影片/**/tmp/
src/resource/**/影片/**/temp/
src/resource/**/影片/**/cache/

