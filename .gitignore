# macOS
*.DS_Store

# Local video production outputs.
# Keep lightweight plans/metadata/subtitles trackable, but never commit generated audio/video.
video-resource/**/audio/
video-resource/**/video/
video-resource/**/output/
video-resource/**/renders/
video-resource/**/source/
video-resource/**/tmp/
video-resource/**/temp/
video-resource/**/cache/

# Audio files
*.aac
*.aif
*.aiff
*.flac
*.m4a
*.mp3
*.ogg
*.opus
*.wav

# Video files
*.avi
*.m4v
*.mkv
*.mov
*.mp4
*.mpeg
*.mpg
*.webm

# Large editing/project artifacts
*.imovieproj
*.imovieproject
*.imovielibrary
*.fcpbundle
*.fcpproject
